<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Pilze Schwyz – Herbst 2026</name>
  <description>Candidate mushroom areas in canton Schwyz, grouped by mushroom type. Pins mark areas, not exact spots; they were checked against the federal forest map, the terrain model and the cantonal reserves. Rules: max 2 kg per person per day, no picking in nature reserves. Generated from data/spots.json (npm run export:spots).</description>

  <Style id="eierschwamm"><IconStyle><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/ylw-circle.png</href></Icon></IconStyle></Style>
  <Style id="steinpilz"><IconStyle><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/orange-circle.png</href></Icon></IconStyle></Style>
  <Style id="buche"><IconStyle><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/purple-circle.png</href></Icon></IconStyle></Style>
  <Style id="achtung"><IconStyle><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href></Icon></IconStyle></Style>

  <Folder>
    <name>Eierschwämme &amp; Trompetenpfifferlinge</name>
    <Placemark>
      <name>Ibergeregg – Alpthal side</name>
      <description>Steep fir-beech forest on limestone (site map: 18M Karbonat-Tannen-Buchenwald), about 40 % conifers. Look on north-facing, mossy slopes and near streams. Bus Schwyz–Ibergeregg or Einsiedeln–Oberiberg.</description>
      <ExtendedData><Data name="Pilz"><value>Eierschwämme / Trompetenpfifferlinge</value></Data><Data name="Höhe"><value>1100–1400 m</value></Data></ExtendedData>
      <styleUrl>#eierschwamm</styleUrl>
      <Point><coordinates>8.70945,47.01929,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Oberiberg – Ybrig forests</name>
      <description>Acidic spruce-fir forest with bilberry (46 Heidelbeer-Tannen-Fichtenwald), about 80 % conifers. Also good for winter chanterelles in late October. Bus from Einsiedeln.</description>
      <ExtendedData><Data name="Pilz"><value>Eierschwämme / Trompetenpfifferlinge</value></Data><Data name="Höhe"><value>1100–1300 m</value></Data></ExtendedData>
      <styleUrl>#eierschwamm</styleUrl>
      <Point><coordinates>8.79127,47.035,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Unteriberg – Studen slopes</name>
      <description>Spruce forest on limestone (60* Buntreitgras-Fichtenwald), almost only conifers. The Breitried reserve (no picking) is nearby: check the reserve layer on map.geo.sz.ch before picking.</description>
      <ExtendedData><Data name="Pilz"><value>Eierschwämme / Trompetenpfifferlinge</value></Data><Data name="Höhe"><value>900–1200 m</value></Data></ExtendedData>
      <styleUrl>#eierschwamm</styleUrl>
      <Point><coordinates>8.83474,47.06201,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Wägital – Innerthal lake slopes</name>
      <description>Fir-beech forest on calcareous soil (18v Buntreitgras-Tannen-Buchenwald mit Rostsegge), mostly broadleaf, on the slopes above the Wägitalersee. Quiet valley. Train to Siebnen, then bus.</description>
      <ExtendedData><Data name="Pilz"><value>Eierschwämme / Trompetenpfifferlinge</value></Data><Data name="Höhe"><value>900–1200 m</value></Data></ExtendedData>
      <styleUrl>#eierschwamm</styleUrl>
      <Point><coordinates>8.93262,47.09712,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Sattel – Hochstuckli</name>
      <description>Acidic spruce-fir forest with bilberry (46 Heidelbeer-Tannen-Fichtenwald) on moraine, about 80 % conifers. Easy access from Sattel station (gondola to Mostelberg).</description>
      <ExtendedData><Data name="Pilz"><value>Eierschwämme / Trompetenpfifferlinge</value></Data><Data name="Höhe"><value>1000–1300 m</value></Data></ExtendedData>
      <styleUrl>#eierschwamm</styleUrl>
      <Point><coordinates>8.66,47.075,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Raten – Biberegg side</name>
      <description>Acidic fir-beech forest with wood-rush (19 Waldsimsen-Tannen-Buchenwald), about 80 % conifers, near the Zug border and the Rothenthurm moors: stay on the Schwyz side and out of the moor reserves.</description>
      <ExtendedData><Data name="Pilz"><value>Eierschwämme / Trompetenpfifferlinge</value></Data><Data name="Höhe"><value>1000–1100 m</value></Data></ExtendedData>
      <styleUrl>#eierschwamm</styleUrl>
      <Point><coordinates>8.6636,47.11407,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>Steinpilze (end of season)</name>
    <Placemark>
      <name>Ibergeregg – upper spruce</name>
      <description>Conifer-rich forest (about 75 % conifers) on calcareous soil; the site map shows maple-ash forest (26w Ahorn-Eschenwald mit Buntreitgras). Just outside the Ibergeregg nature reserve. Go early in the season, before frost reaches this height.</description>
      <ExtendedData><Data name="Pilz"><value>Steinpilze</value></Data><Data name="Höhe"><value>1200–1400 m</value></Data></ExtendedData>
      <styleUrl>#steinpilz</styleUrl>
      <Point><coordinates>8.71647,47.01597,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Hoch-Ybrig – Weglosen</name>
      <description>Steep fir-beech forest on limestone (18M Karbonat-Tannen-Buchenwald), about a third conifers. The Hoch-Ybrig plant protection reserve (no picking) is close by. Bus Einsiedeln–Oberiberg–Weglosen.</description>
      <ExtendedData><Data name="Pilz"><value>Steinpilze</value></Data><Data name="Höhe"><value>1050–1300 m</value></Data></ExtendedData>
      <styleUrl>#steinpilz</styleUrl>
      <Point><coordinates>8.8087,47.03749,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Hochstuckli – upper slopes</name>
      <description>Fir-spruce forest with tall herbs (50 Hochstauden-Tannen-Fichtenwald), neutral soil, almost only conifers, above Mostelberg.</description>
      <ExtendedData><Data name="Pilz"><value>Steinpilze</value></Data><Data name="Höhe"><value>1200–1400 m</value></Data></ExtendedData>
      <styleUrl>#steinpilz</styleUrl>
      <Point><coordinates>8.67133,47.07197,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Haggenegg – Alpthal side</name>
      <description>Fir-beech forest with tall herbs (20 Hochstauden-Tannen-Buchenwald) on moraine, mixed conifers and broadleaf, below the pass. The Mythen plant protection reserve (no picking) borders it. Bus to Alpthal, then hike up.</description>
      <ExtendedData><Data name="Pilz"><value>Steinpilze</value></Data><Data name="Höhe"><value>1100–1400 m</value></Data></ExtendedData>
      <styleUrl>#steinpilz</styleUrl>
      <Point><coordinates>8.69324,47.04061,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>Totentrompeten, Semmelstoppelpilze, Hallimasch (beech, lower)</name>
    <Placemark>
      <name>Rigi north – above Küssnacht</name>
      <description>Beech forest (8 Waldhirsen-Buchenwald) on moraine, neutral soil, toward Seebodenalp. Frost comes later here, so this works into November.</description>
      <ExtendedData><Data name="Pilz"><value>Totentrompeten / Semmelstoppelpilze</value></Data><Data name="Höhe"><value>600–1000 m</value></Data></ExtendedData>
      <styleUrl>#buche</styleUrl>
      <Point><coordinates>8.45424,47.06015,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Rigi – above Arth-Goldau</name>
      <description>Steep beech forest on calcareous soil (17 Steilhang-Buchenwald mit Buntreitgras). Direct train from Zürich to Arth-Goldau.</description>
      <ExtendedData><Data name="Pilz"><value>Totentrompeten / Hallimasch</value></Data><Data name="Höhe"><value>600–1000 m</value></Data></ExtendedData>
      <styleUrl>#buche</styleUrl>
      <Point><coordinates>8.52534,47.04763,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Morschach forest slopes</name>
      <description>Beech forest (8 Waldhirsen-Buchenwald), neutral soil, above the Urnersee. Bus from Brunnen.</description>
      <ExtendedData><Data name="Pilz"><value>Totentrompeten / Semmelstoppelpilze</value></Data><Data name="Höhe"><value>650–1000 m</value></Data></ExtendedData>
      <styleUrl>#buche</styleUrl>
      <Point><coordinates>8.625,46.975,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Gersau beech forests</name>
      <description>Beech-lime forest on limestone (13T Bingelkraut-Buchenwald mit Linde), almost only broadleaf, on the slopes above the lake. Boat or bus from Brunnen.</description>
      <ExtendedData><Data name="Pilz"><value>Totentrompeten / Hallimasch</value></Data><Data name="Höhe"><value>500–900 m</value></Data></ExtendedData>
      <styleUrl>#buche</styleUrl>
      <Point><coordinates>8.515,46.995,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>No picking – reserves (approximate)</name>
    <Placemark>
      <name>Rothenthurm moorland reserves</name>
      <description>Approximate centre only. No picking in the listed reserves (e.g. Breitried, Schützenried). Real boundaries come in a later version.</description>
      <ExtendedData><Data name="Pilz"><value>Verbot</value></Data></ExtendedData>
      <styleUrl>#achtung</styleUrl>
      <Point><coordinates>8.675,47.1,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Schwantenau</name>
      <description>Approximate centre only. Nature reserve, no picking. Roblosen is also nearby.</description>
      <ExtendedData><Data name="Pilz"><value>Verbot</value></Data></ExtendedData>
      <styleUrl>#achtung</styleUrl>
      <Point><coordinates>8.735,47.145,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Oberer Sihlsee</name>
      <description>Approximate centre only. Nature reserve at the upper end of the lake, no picking.</description>
      <ExtendedData><Data name="Pilz"><value>Verbot</value></Data></ExtendedData>
      <styleUrl>#achtung</styleUrl>
      <Point><coordinates>8.775,47.1,0</coordinates></Point>
    </Placemark>
  </Folder>
</Document>
</kml>
