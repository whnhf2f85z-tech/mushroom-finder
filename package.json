{
  "name": "mushroom-finder",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "pipeline"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/scoring && tsc -p pipeline && tsc -p web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "daily": "tsx pipeline/src/run.ts",
    "record:golden": "tsx pipeline/scripts/record-golden.ts",
    "terrain": "tsx pipeline/terrain/build-habitat.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
